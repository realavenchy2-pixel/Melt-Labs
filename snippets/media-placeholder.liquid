{%- comment -%}
  Final-asset placeholder policy (brief §5): every media slot renders at the
  exact final aspect ratio so the real asset drops in with zero layout shift.

  Params:
    label          — human name of the asset that will be swapped in (required)
    aspect_mobile  — CSS aspect-ratio below 768px, e.g. '9 / 16' (required)
    aspect_desktop — CSS aspect-ratio at 768px+, defaults to aspect_mobile
    image          — optional image object; when set, renders instead of the placeholder
    video          — optional Shopify video object; when set, renders instead (muted loop)
    eager          — set true only for above-the-fold media (hero)
    sizes          — sizes attribute for the image (default '100vw')
    class          — extra classes for the wrapper
{%- endcomment -%}

{%- liquid
  assign aspect_desktop = aspect_desktop | default: aspect_mobile
  assign sizes = sizes | default: '100vw'
-%}

<!-- SWAP: {{ label }}, {{ aspect_mobile }} mobile / {{ aspect_desktop }} desktop -->
<div
  class="media-slot {{ class }}"
  style="--aspect-mobile: {{ aspect_mobile }}; --aspect-desktop: {{ aspect_desktop }};"
>
  <div class="media-slot__frame"></div>

  {%- if video -%}
    {%- comment -%}
      Hand-built <video> tag rather than Shopify's video_tag filter: iOS
      Safari only allows inline autoplay when muted + playsinline are
      present as literal HTML attributes at parse time, and video_tag's
      generated markup doesn't reliably guarantee that. scroll-fx.js also
      calls .play() on load as a safety net for browsers that ignore the
      autoplay attribute under certain network conditions.
    {%- endcomment -%}
    <video
      class="hero-video"
      data-autoplay-video
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      disablepictureinpicture
      disableremoteplayback
      preload="auto"
      aria-hidden="true"
      tabindex="-1"
    >
      {%- for source in video.sources -%}
        <source src="{{ source.url }}" type="{{ source.mime_type }}">
      {%- endfor -%}
    </video>
  {%- elsif image -%}
    {%- render 'responsive-image', image: image, sizes: sizes, eager: eager -%}
  {%- else -%}
    <div class="media-slot__label" aria-hidden="true">
      <strong>{{ label }}</strong>
      <span>{{ aspect_mobile }} mobile &middot; {{ aspect_desktop }} desktop</span>
    </div>
  {%- endif -%}
</div>
