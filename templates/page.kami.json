    "benefit": {
      "type": "benefit-statement",
      "blocks": {
        "stmt_1": {
          "type": "statement",
          "settings": {
            "headline": "Miniaturized Is Not the Same as *Gone.*",
            "subhead": "For years, people looked at thinning areas and assumed every barely visible follicle was permanently dead. But pattern thinning often happens through miniaturization: the follicle gradually produces strands that are finer, weaker, shorter-lived, and harder to see under normal lighting. Over time, once-thick strands can become so small they appear to have disappeared. That changes the question from “Is this follicle dead?” to “How do I better support the environment around thinning-looking follicles?” That is the question KAMI 15 was created around."
          }
        },
        "ang_1": {
          "type": "slide",
          "settings": {
            "title": "Support the scalp environment",
            "text": "Hair begins at the scalp. KAMI’s peptides and botanicals help support the moisture, comfort, and cosmetic environment surrounding thinning-looking areas.",
            "show_media_slot": false,
            "accent": true
          }
        },
        "ang_2": {
          "type": "slide",
          "settings": {
            "title": "Support stronger-looking strands",
            "text": "Conditioned strands appear smoother, healthier, and less fragile, helping the hair you still have look its best.",
            "show_media_slot": false,
            "accent": false
          }
        },
        "ang_3": {
          "type": "slide",
          "settings": {
            "title": "Support the appearance of density",
            "text": "With consistent use, the goal is hair that looks fuller at the root and less visibly sparse under mirrors, phone cameras, and overhead lighting.",
            "show_media_slot": false,
            "accent": false
          }
        },
        "ang_4": {
          "type": "slide",
          "settings": {
            "title": "Defend the hair you still have",
            "text": "Conditioning botanicals support softer, stronger-feeling strands and help reduce the visible effects of dryness and breakage.",
            "show_media_slot": false,
            "accent": false
          }
        }
      },
      "block_order": [
        "stmt_1",
        "ang_1",
        "ang_2",
