    "faq": {
      "type": "faq",
      "blocks": {
        "faq_1": {
          "type": "qa",
          "settings": {
            "question": "How do I apply KAMI 15?",
            "answer": "Apply four drops total directly to thinning-looking areas each day. Use all four at once or divide them between morning and evening. Massage into a dry or damp scalp and leave the serum in."
          }
        },
        "faq_2": {
          "type": "qa",
          "settings": {
            "question": "Do I rinse it out?",
            "answer": "No. KAMI is a leave-in scalp serum."
          }
        },
        "faq_3": {
          "type": "qa",
          "settings": {
            "question": "How long does one bottle last?",
            "answer": "The 60 mL bottle lasts approximately one to one-and-a-half months when used as directed."
          }
        },
        "faq_4": {
          "type": "qa",
          "settings": {
            "question": "Is KAMI made with minoxidil?",
            "answer": "No. KAMI is completely minoxidil-free."
          }
        },
        "faq_5": {
          "type": "qa",
          "settings": {
            "question": "Is KAMI a treatment for hair loss?",
            "answer": "No. KAMI is a cosmetic scalp and hair serum designed to support fuller-looking density and healthier-looking hair. Speak with a dermatologist about medical hair-loss concerns."
          }
        },
        "faq_6": {
          "type": "qa",
          "settings": {
            "question": "Does KAMI wake up dead follicles?",
            "answer": "KAMI does not claim to resurrect permanently inactive follicles. It is designed to support the scalp environment around thinning-looking and miniaturized areas."
          }
        },
        "faq_7": {
          "type": "qa",
          "settings": {
            "question": "When should I expect visible results?",
            "answer": "Timelines vary. Scalp comfort and strand conditioning may be noticed first. Fuller-looking density requires consistent use over a period of months because hair follows a slow cycle."
          }
        },
        "faq_8": {
          "type": "qa",
          "settings": {
            "question": "Can men and women use the same formula?",
            "answer": "Yes. The same KAMI formula and application directions are designed for both men and women."
          }
        },
        "faq_9": {
          "type": "qa",
          "settings": {
            "question": "Can I use it on color-treated hair?",
            "answer": "Yes. Apply KAMI to the scalp rather than saturating the lengths. Patch-test first if you have a sensitive scalp."
          }
        },
        "faq_10": {
          "type": "qa",
          "settings": {
            "question": "Is it greasy or strongly scented?",
            "answer": "No. KAMI is lightweight and fragrance-free."
          }
        },
        "faq_11": {
          "type": "qa",
          "settings": {
            "question": "What is the return policy?",
