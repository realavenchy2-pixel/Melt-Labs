        "faq_1": {
          "type": "qa",
          "settings": {
            "question": "How do I use Special Water?",
            "answer": "Add two squirts to whatever you are already drinking, once or twice daily as directed on the label. It works in water, coffee, tea, or juice."
          }
        },
        "faq_2": {
          "type": "qa",
          "settings": {
            "question": "What does it taste like?",
            "answer": "Nothing. Special Water was designed to disappear into hot or cold drinks without changing their normal taste."
          }
        },
        "faq_3": {
          "type": "qa",
          "settings": {
            "question": "How quickly should I expect to notice something?",
            "answer": "Everyone responds differently. Appetite and craving support may be noticed first, while broader results require consistent daily use over time."
          }
        },
        "faq_4": {
          "type": "qa",
          "settings": {
            "question": "Does Special Water replace Ozempic or another GLP-1 medication?",
            "answer": "No. Special Water is a dietary supplement, not a prescription medication or replacement for medical care. Speak with your physician before making changes to any prescribed treatment."
          }
        },
        "faq_5": {
          "type": "qa",
          "settings": {
            "question": "Is this a stimulant fat burner?",
            "answer": "The formula is not built around the high-stimulant approach used by many conventional fat burners. Review the complete ingredient label before use, particularly if you are sensitive to caffeine or botanical extracts."
          }
        },
        "faq_6": {
          "type": "qa",
          "settings": {
            "question": "Can I take it with medication?",
            "answer": "Speak with your physician before using Special Water if you take prescription medication, use a GLP-1, have a medical condition, are pregnant, or are nursing."
          }
        },
        "faq_7": {
          "type": "qa",
          "settings": {
            "question": "What ingredients are inside?",
            "answer": "The formula contains Cinnamomum cassia bark extract, Japanese knotweed extract, bitter melon extract, turmeric root extract, licorice root extract, and matcha."
          }
        },
        "faq_8": {
          "type": "qa",
          "settings": {
            "question": "What is the return policy?",
            "answer": "You are protected by a 60-day money-back guarantee. Contact the support team within 60 days of delivery if Special Water is not right for you."
