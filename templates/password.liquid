<div class="page-shell" style="min-height: 70svh; display: flex; align-items: center;">
  <div class="container container--narrow" style="text-align: center;">
    <h1 class="h1">{{ shop.name }}</h1>
    <p class="lead" style="margin: 1.25rem auto 2rem;">Opening soon.</p>
    {% form 'storefront_password', class: 'form-stack' %}
      {{ form.errors | default_errors }}
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password">
      <button type="submit" class="btn btn--gold">Enter</button>
    {% endform %}
  </div>
</div>
