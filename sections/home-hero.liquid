{%- comment -%}
  Homepage brand hero (brief §3: Apple.com-style brand hub, not a sales
  page). One clean statement, optional background image OR video chosen
  with the "Background media" toggle, primary CTA into the lineup.
  Deliberately calmer than the product hero.
{%- endcomment -%}

{%- liquid
  # Decide whether any background media is in play. "None" keeps the
  # flat brand scheme; otherwise hero-media resolves the mobile/desktop
  # asset for the chosen type.
  assign has_media = false
  if section.settings.media_type == 'video'
    if section.settings.video != blank or section.settings.video_mobile != blank
      assign has_media = true
    endif
  elsif section.settings.media_type == 'image'
    if section.settings.image != blank or section.settings.image_mobile != blank
      assign has_media = true
    endif
  endif
  assign hero_mode = section.settings.hero_size | default: 'fill'

  # Matches the product hero: the control only makes sense over footage
  # that is actually running.
  assign show_toggle = false
  if section.settings.media_type == 'video' and section.settings.show_video_toggle
    if section.settings.video != blank or section.settings.video_mobile != blank
      assign show_toggle = true
    endif
  endif
-%}

<section
  class="home-hero home-hero--{{ section.settings.scheme | default: 'tint' }} home-hero--{{ hero_mode }}{% if has_media %} home-hero--has-media{% endif %}"
  style="--hero-aspect-mobile: {{ section.settings.aspect_mobile }}; --hero-aspect-desktop: {{ section.settings.aspect_desktop }}; --hero-fit: {{ section.settings.media_fit }};"
  data-hero
>
  {%- if has_media -%}
    <div class="home-hero__media">
      {%- render 'hero-media',
        media_type: section.settings.media_type,
        video_desktop: section.settings.video,
        video_mobile: section.settings.video_mobile,
        image_desktop: section.settings.image,
        image_mobile: section.settings.image_mobile,
        label: 'home_hero_background',
        aspect_mobile: '3 / 4',
        aspect_desktop: '16 / 9',
        eager: true
      -%}
      <div class="home-hero__scrim" aria-hidden="true" style="--scrim-opacity: {{ section.settings.overlay_darkness }};"></div>
    </div>
  {%- endif -%}

  <div class="container home-hero__content {% if has_media %}home-hero__content--over-media{% endif %}">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1 class="home-hero__headline">{% render 'accent-text', text: section.settings.headline, color: 'blue' %}</h1>
    {%- if section.settings.subhead != blank -%}
      <p class="home-hero__subhead">{{ section.settings.subhead }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <div class="home-hero__actions">
        <a class="btn btn--gold" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
        {%- comment -%}
          Over media the second action becomes a chevron link rather than
          a second button, matching the product hero: two buttons of
          equal weight side by side make neither one primary. With no
          media behind it there is nothing to keep the composition
          quiet, so the outline button still reads correctly there.
        {%- endcomment -%}
        {%- if section.settings.cta2_label != blank -%}
          {%- if has_media -%}
            <a class="hero__link" href="{{ section.settings.cta2_link | default: '#' }}">
              {{ section.settings.cta2_label }}
              <span class="hero__link-chevron" aria-hidden="true">{% render 'icon', name: 'chevron-right' %}</span>
            </a>
          {%- else -%}
            <a class="btn btn--outline" href="{{ section.settings.cta2_link | default: '#' }}">{{ section.settings.cta2_label }}</a>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if show_toggle -%}
    <button
      class="hero__video-toggle"
      type="button"
      data-video-toggle
      aria-pressed="false"
      aria-label="Pause background video"
    >
      <span class="hero__video-toggle-icon" data-video-toggle-icon="pause">{% render 'icon', name: 'pause' %}</span>
      <span class="hero__video-toggle-icon" data-video-toggle-icon="play" hidden>{% render 'icon', name: 'play' %}</span>
    </button>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme (when no background media)",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "tint", "label": "Pale blue" },
        { "value": "ink", "label": "Near-black" }
      ],
      "default": "tint"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Background media",
      "info": "None keeps a flat brand background. Both assets can stay uploaded while you decide.",
      "options": [
        { "value": "none", "label": "None (flat color)" },
        { "value": "video", "label": "Video" },
        { "value": "image", "label": "Image" }
      ],
      "default": "none"
    },
    { "type": "video", "id": "video", "label": "Desktop background video" },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile background video",
      "info": "Optional. Falls back to the desktop video if empty."
    },
    { "type": "image_picker", "id": "image", "label": "Desktop background image" },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile background image",
      "info": "Optional. Falls back to the desktop image if empty."
    },
    {
      "type": "range",
      "id": "overlay_darkness",
      "label": "Overlay darkness",
      "info": "Darkens the background so the headline pops. Only applies when a background image or video is set; 100 makes the bottom of the frame fully solid.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "show_video_toggle",
      "label": "Show a play/pause button on the video",
      "info": "Sits in the bottom corner of the frame. Only appears when the background is a video.",
      "default": true
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MELT LABS" },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "info": "Wrap a word in *asterisks* to accent it.",
      "default": "Weight control, *made effortless.*"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subhead",
      "default": "Japanese botanical formulas that work with your body, not against your routine."
    },
    { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Shop Special Water" },
    { "type": "url", "id": "cta_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "Explore the science" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" },
    { "type": "header", "content": "Frame shape (when a background is set)" },
    {
      "type": "select",
      "id": "hero_size",
      "label": "Hero height",
      "info": "Fill screen crops to a tall banner. Fixed ratio sizes the frame to match your background video/image.",
      "options": [
        { "value": "fill", "label": "Fill screen" },
        { "value": "sized", "label": "Fixed ratio" }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "aspect_desktop",
      "label": "Desktop ratio",
      "options": [
        { "value": "16 / 9", "label": "16:9 (wide)" },
        { "value": "1 / 1", "label": "1:1 (square)" },
        { "value": "4 / 5", "label": "4:5 (portrait)" },
        { "value": "9 / 16", "label": "9:16 (tall)" },
        { "value": "3 / 4", "label": "3:4 (portrait)" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "select",
      "id": "aspect_mobile",
      "label": "Mobile ratio",
      "options": [
        { "value": "3 / 4", "label": "3:4 (portrait)" },
        { "value": "9 / 16", "label": "9:16 (tall)" },
        { "value": "1 / 1", "label": "1:1 (square)" },
        { "value": "4 / 5", "label": "4:5 (portrait)" },
        { "value": "16 / 9", "label": "16:9 (wide)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "options": [
        { "value": "cover", "label": "Cover (fill)" },
        { "value": "contain", "label": "Contain (show all)" }
      ],
      "default": "cover"
    }
  ],
  "presets": [{ "name": "Home hero" }]
}
{% endschema %}
