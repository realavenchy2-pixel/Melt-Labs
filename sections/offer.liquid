{%- comment -%}
  Offer page purchase experience (Apple-style dedicated buy page). Media
  gallery on one side, purchase panel on the other. The purchase panel
  holds a real, native product form with an optional bundle-tier
  selector: each tier adds real units to the cart, so fulfilment and the
  cart line always match. No hardcoded tier prices, so what the shopper
  sees is enforced by a Shopify discount at checkout.
{%- endcomment -%}

{%- liquid
  if section.settings.product != blank
    assign product = section.settings.product
  endif
-%}

<section id="offer" class="section offer">
  <div class="container">
    <div class="offer__grid">
      {%- comment -%}
        No [data-reveal] here: this is the first section on the product
        template and its image is the LCP element. Fading it in would
        delay LCP behind a deferred script.
      {%- endcomment -%}
      <div class="offer__media">
        {%- if product != blank and product.images.size > 1 -%}
          {%- capture slides -%}
            {%- for image in product.images -%}
              <div class="carousel__slide">
                <div class="media-slot media-slot--rounded" style="--aspect-mobile: {{ section.settings.aspect_mobile }}; --aspect-desktop: {{ section.settings.aspect_desktop }};">
                  <div class="media-slot__frame"></div>
                  {%- render 'responsive-image', image: image, sizes: '(min-width: 900px) 45vw, 100vw', eager: forloop.first -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endcapture -%}
          <div class="offer__carousel">
            {%- render 'carousel', slides: slides, id: section.id, label: product.title -%}
          </div>
        {%- elsif product != blank and product.images.size == 1 -%}
          <div class="media-slot media-slot--rounded" style="--aspect-mobile: {{ section.settings.aspect_mobile }}; --aspect-desktop: {{ section.settings.aspect_desktop }};">
            <div class="media-slot__frame"></div>
            {%- render 'responsive-image', image: product.featured_image, sizes: '(min-width: 900px) 45vw, 100vw', eager: true -%}
          </div>
        {%- elsif section.settings.image != blank -%}
          <div class="media-slot media-slot--rounded" style="--aspect-mobile: {{ section.settings.aspect_mobile }}; --aspect-desktop: {{ section.settings.aspect_desktop }};">
            <div class="media-slot__frame"></div>
            {%- render 'responsive-image', image: section.settings.image, sizes: '(min-width: 900px) 45vw, 100vw', eager: true -%}
          </div>
        {%- else -%}
          {%- render 'media-placeholder', label: 'product_gallery_photo', aspect_mobile: section.settings.aspect_mobile, aspect_desktop: section.settings.aspect_desktop, class: 'media-slot--rounded', eager: true -%}
        {%- endif -%}
      </div>

      <div class="offer__panel">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if product != blank -%}
          <h1 class="offer__title">{{ product.title }}</h1>
          {%- if section.settings.tagline != blank -%}
            <p class="lead offer__tagline">{{ section.settings.tagline }}</p>
          {%- endif -%}

          {%- assign variant = product.selected_or_first_available_variant -%}

          {%- comment -%} Count tier blocks; the first highlighted one is pre-selected, else the first. {%- endcomment -%}
          {%- assign tier_count = 0 -%}
          {%- assign default_index = -1 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tier' -%}
              {%- if block.settings.highlighted and default_index == -1 -%}
                {%- assign default_index = tier_count -%}
              {%- endif -%}
              {%- assign tier_count = tier_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if default_index == -1 -%}
            {%- assign default_index = 0 -%}
          {%- endif -%}

          {%- if tier_count == 0 -%}
            <div class="offer__price">
              <span>{{ variant.price | money }}</span>
              {%- if variant.compare_at_price > variant.price -%}
                <s>{{ variant.compare_at_price | money }}</s>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- form 'product', product, class: 'offer__form' -%}
            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <div class="offer__field">
                  <label for="offer-option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name }}</label>
                  <select id="offer-option-{{ section.id }}-{{ forloop.index0 }}" name="options[{{ option.name | escape }}]">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endfor -%}
            {%- endunless -%}

            {%- if tier_count > 0 -%}
              {%- if section.settings.bundle_heading != blank -%}
                <p class="bundle__heading">{{ section.settings.bundle_heading }}</p>
              {%- endif -%}
              <div class="bundle" data-bundle role="radiogroup" aria-label="{{ section.settings.bundle_heading | default: 'Choose a bundle' | escape }}">
                {%- assign tier_i = 0 -%}
                {%- for block in section.blocks -%}
                  {%- if block.type == 'tier' -%}
                  {%- assign checked = false -%}
                  {%- if tier_i == default_index -%}{%- assign checked = true -%}{%- endif -%}
                  <label class="bundle__tier{% if checked %} is-selected{% endif %}{% if block.settings.highlighted %} bundle__tier--popular{% endif %}" {{ block.shopify_attributes }}>
                    <input
                      class="bundle__radio"
                      type="radio"
                      name="quantity"
                      value="{{ block.settings.units }}"
                      data-bundle-tier
                      data-code="{{ block.settings.discount_code | escape }}"
                      data-price="{{ block.settings.price | escape }}"
                      {% if checked %}checked{% endif %}
                    >
                    {%- if block.settings.badge != blank -%}
                      <span class="bundle__tier-badge">{{ block.settings.badge }}</span>
                    {%- endif -%}
                    <span class="bundle__tier-check" aria-hidden="true">{% render 'icon', name: 'check' %}</span>
                    <span class="bundle__tier-info">
                      <span class="bundle__tier-title">{{ block.settings.label }}</span>
                      {%- if block.settings.sublabel != blank -%}
                        <span class="bundle__tier-sub">{{ block.settings.sublabel }}</span>
                      {%- endif -%}
                    </span>
                    <span class="bundle__tier-pricing">
                      <span class="bundle__tier-price">{{ block.settings.price }}</span>
                      {%- if block.settings.compare_price != blank -%}
                        <s class="bundle__tier-compare">{{ block.settings.compare_price }}</s>
                      {%- endif -%}
                      {%- if block.settings.per_unit != blank -%}
                        <span class="bundle__tier-per">{{ block.settings.per_unit }}</span>
                      {%- endif -%}
                    </span>
                  </label>
                  {%- assign tier_i = tier_i | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if section.settings.bundle_note != blank -%}
                <p class="bundle__note">{{ section.settings.bundle_note }}</p>
              {%- endif -%}
            {%- else -%}
              {%- comment -%}
                No quantity stepper: one bottle is the default purchase and
                the tier blocks above are how a shopper buys more. The
                hidden field keeps the posted quantity explicit rather
                than relying on Shopify's implicit default.
              {%- endcomment -%}
              <input type="hidden" name="quantity" value="1">
            {%- endif -%}

            <input type="hidden" name="id" value="{{ variant.id }}">

            <div class="offer__actions">
              <button
                type="submit"
                name="add"
                class="btn btn--gold btn--full"
                data-bundle-add
                {% unless variant.available %}disabled{% endunless %}
              >
                {%- if variant.available -%}
                  {{ section.settings.add_label | default: 'Add to bag' }}
                {%- else -%}
                  Sold out
                {%- endif -%}
                <span data-bundle-total-suffix></span>
              </button>
              {%- if tier_count == 0 -%}{{ form | payment_button }}{%- endif -%}
            </div>
            {%- if section.settings.under_button != blank -%}
              <p class="offer__under-button">{{ section.settings.under_button }}</p>
            {%- endif -%}
          {%- endform -%}

          {%- if section.settings.reassurance != blank -%}
            <ul class="offer__reassure">
              {%- assign items = section.settings.reassurance | newline_to_br | split: '<br />' -%}
              {%- for item in items -%}
                {%- assign trimmed = item | strip -%}
                {%- if trimmed != blank -%}
                  <li>{% render 'icon', name: 'check' %}{{ trimmed }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.trust_line != blank -%}
            <p class="offer__trust">{% render 'icon', name: 'shield' %}{{ section.settings.trust_line }}</p>
          {%- endif -%}

          {%- if section.settings.show_description and product.description != blank -%}
            <div class="offer__description rte">{{ product.description }}</div>
          {%- endif -%}

          {%- assign info_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'info' -%}
              {%- assign info_count = info_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if info_count > 0 -%}
            <div class="offer__info">
              {%- for block in section.blocks -%}
                {%- if block.type == 'info' -%}
                <details class="faq__item" data-faq-item {{ block.shopify_attributes }}>
                  <summary class="faq__q">
                    <span>{{ block.settings.title }}</span>
                    <span class="faq__chevron" aria-hidden="true">{% render 'icon', name: 'chevron-right' %}</span>
                  </summary>
                  <div class="faq__a" data-faq-content>
                    <div class="rte">{{ block.settings.content }}</div>
                  </div>
                </details>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <h1 class="offer__title">{{ section.settings.placeholder_title }}</h1>
          <p class="lead offer__tagline">Select a product for this section in the theme editor to activate the offer.</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Offer",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "On product pages this defaults to the current product."
    },
    { "type": "image_picker", "id": "image", "label": "Fallback photo (if the product has no images)" },
    {
      "type": "select",
      "id": "aspect_desktop",
      "label": "Desktop image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "select",
      "id": "aspect_mobile",
      "label": "Mobile image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "1 / 1"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MELT LABS" },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add to cart button label",
      "info": "Leave blank for the default 'Add to bag'. The price is never baked in here - Shopify renders it dynamically.",
      "default": "Add to bag"
    },
    {
      "type": "text",
      "id": "under_button",
      "label": "Under-button reassurance",
      "info": "Small line directly beneath the add to cart button.",
      "default": ""
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "The daily protocol for quieter cravings and steadier blood sugar."
    },
    {
      "type": "header",
      "content": "Bundle & pricing"
    },
    {
      "type": "paragraph",
      "content": "Add Bundle tier blocks to build the selector. Each tier adds real units to the cart. Match the shown price at checkout with an automatic quantity discount, or set a discount code on the tier."
    },
    {
      "type": "text",
      "id": "bundle_heading",
      "label": "Bundle heading",
      "default": "Choose your supply"
    },
    {
      "type": "text",
      "id": "bundle_note",
      "label": "Small note under the tiers",
      "default": "Bulk savings apply automatically at checkout."
    },
    {
      "type": "header",
      "content": "Trust"
    },
    {
      "type": "textarea",
      "id": "reassurance",
      "label": "Reassurance points (one per line)",
      "default": "60-day money-back guarantee\nShips in 2 to 4 days\nThird-party tested"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Secure-checkout line",
      "default": "Secure checkout. Cancel anytime."
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show the product description",
      "default": true
    },
    {
      "type": "text",
      "id": "placeholder_title",
      "label": "Placeholder title (no product selected)",
      "default": "Special Water"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        {
          "type": "range",
          "id": "units",
          "label": "Units added to cart",
          "info": "How many bottles this tier adds. Supliful fulfils this exact count, and the cart shows every unit.",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 1
        },
        { "type": "text", "id": "label", "label": "Title", "default": "1 Bottle" },
        { "type": "text", "id": "sublabel", "label": "Subtitle", "default": "30-day supply" },
        { "type": "text", "id": "badge", "label": "Badge (optional)", "info": "e.g. MOST POPULAR or SAVE 25%" },
        {
          "type": "text",
          "id": "price",
          "label": "Price shown",
          "info": "The agreed price to display, e.g. $79. Enforce it at checkout with a matching discount (see the Bundle & pricing note above).",
          "default": "$79"
        },
        { "type": "text", "id": "compare_price", "label": "Compare-at price (optional)", "info": "Struck-through original, e.g. $79" },
        { "type": "text", "id": "per_unit", "label": "Per-unit note (optional)", "info": "e.g. $50/bottle" },
        {
          "type": "text",
          "id": "discount_code",
          "label": "Discount code (optional)",
          "info": "A Shopify discount code applied automatically when this tier is chosen, so checkout matches the price shown. Leave blank if you use an automatic discount instead."
        },
        { "type": "checkbox", "id": "highlighted", "label": "Highlight as most popular", "default": false }
      ]
    },
    {
      "type": "info",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "How to use" },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add the details here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Offer",
      "blocks": [
        { "type": "tier", "settings": { "units": 1, "label": "1 Bottle", "sublabel": "30-day supply", "price": "$79", "per_unit": "$79/bottle" } },
        { "type": "tier", "settings": { "units": 3, "label": "3 Bottles", "sublabel": "90-day supply", "badge": "MOST POPULAR", "price": "$177", "compare_price": "$237", "per_unit": "$59/bottle", "highlighted": true } },
        { "type": "tier", "settings": { "units": 6, "label": "6 Bottles", "sublabel": "180-day supply", "badge": "BEST VALUE", "price": "$294", "compare_price": "$474", "per_unit": "$49/bottle" } },
        {
          "type": "info",
          "settings": {
            "title": "How to use",
            "content": "<p>Two drops in whatever you're already drinking, once or twice a day.</p>"
          }
        },
        {
          "type": "info",
          "settings": {
            "title": "Shipping and returns",
            "content": "<p>Ships in 2 to 4 days. 60-day money-back guarantee.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
