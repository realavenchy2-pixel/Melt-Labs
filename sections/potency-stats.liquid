{%- comment -%}
  S9 — Potency / efficacy (reference: PDF p.19, Apple's "8 hrs / 10 hrs"
  battery stack). Big stat values with hairline dividers; copy explains
  all-day support rather than a short-lived spike. The media slot beside
  the stats accepts an optional how-to-use photo (4:5) OR a 9:16
  explainer video (video wins if both are set) - same tap-to-play,
  native-controls pattern as expert-reviews.liquid, since this is a
  watch-me explainer clip, not a muted ambient loop.
{%- endcomment -%}

<section class="section section--scheme-tint">
  <div class="container">
    <div class="featured">
      <div class="featured__media" data-reveal>
        {%- if section.settings.video != blank -%}
          {%- assign video_poster = section.settings.video_poster | default: section.settings.image -%}
          <div class="media-slot media-slot--rounded" style="--aspect-mobile: 9 / 16; --aspect-desktop: 9 / 16;">
            <div class="media-slot__frame"></div>
            <video
              controls
              playsinline
              webkit-playsinline
              preload="none"
              {%- if video_poster != blank %} poster="{{ video_poster | image_url: width: 800 }}"{% endif %}
            >
              {%- for source in section.settings.video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          </div>
        {%- else -%}
          {%- render 'media-placeholder', image: section.settings.image, label: 'how_to_use_photo', aspect_mobile: '4 / 5', class: 'media-slot--rounded' -%}
        {%- endif -%}
      </div>

      <div class="featured__body" data-reveal style="--reveal-i: 1;">
        <div class="section-header" style="margin-bottom: 2rem;">
          <h2 class="h2">{{ section.settings.headline }}</h2>
          {%- if section.settings.body != blank -%}
            <p class="lead">{{ section.settings.body }}</p>
          {%- endif -%}
        </div>

        <div class="stat-row">
          {%- for block in section.blocks -%}
            <div class="stat" data-reveal style="--reveal-i: {{ forloop.index0 | plus: 2 }};" {{ block.shopify_attributes }}>
              {%- if block.settings.intro != blank -%}
                <p class="stat__intro">{{ block.settings.intro }}</p>
              {%- endif -%}
              <p class="stat__value">{{ block.settings.value }}</p>
              <p class="stat__caption">{{ block.settings.caption }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Potency stats",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "How-to-use photo" },
    {
      "type": "video",
      "id": "video",
      "label": "How-to-use video (9:16)",
      "info": "Optional. Swaps out the photo for a vertical explainer video with sound and tap-to-play controls. Takes priority over the photo when set."
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video poster frame",
      "info": "Shown before the video is played. Falls back to the how-to-use photo above if left blank."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "A couple of squirts. That's the entire routine."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Potency that carries through the day, supporting appetite control and blood sugar stability continuously. Not a short-lived spike."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "intro", "label": "Lead-in", "default": "Just" },
        { "type": "text", "id": "value", "label": "Value", "default": "2 drops" },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "in whatever you're already drinking"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Potency stats",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "intro": "Just",
            "value": "2 drops",
            "caption": "in whatever you're already drinking"
          }
        },
        {
          "type": "stat",
          "settings": {
            "intro": "Support that lasts",
            "value": "All day",
            "caption": "steady appetite and blood sugar support, morning to night"
          }
        }
      ]
    }
  ]
}
{% endschema %}
