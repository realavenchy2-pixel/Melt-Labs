{%- comment -%}
  S9 — Potency / efficacy (reference: PDF p.19, Apple's "8 hrs / 10 hrs"
  battery stack). Big stat values with hairline dividers; copy explains
  all-day support rather than a short-lived spike.
{%- endcomment -%}

<section class="section section--scheme-tint">
  <div class="container container--narrow">
    <div class="section-header section-header--center" data-reveal>
      <h2 class="h2">{{ section.settings.headline }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="lead" style="margin-inline: auto;">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div class="stat-row">
      {%- for block in section.blocks -%}
        <div class="stat" data-reveal style="--reveal-i: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          {%- if block.settings.intro != blank -%}
            <p class="stat__intro">{{ block.settings.intro }}</p>
          {%- endif -%}
          <p class="stat__value">{{ block.settings.value }}</p>
          <p class="stat__caption">{{ block.settings.caption }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Potency stats",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "A couple of squirts. That's the entire routine."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Potency that carries through the day, supporting appetite control and blood sugar stability continuously. Not a short-lived spike."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "intro", "label": "Lead-in", "default": "Just" },
        { "type": "text", "id": "value", "label": "Value", "default": "2 drops" },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "in whatever you're already drinking"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Potency stats",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "intro": "Just",
            "value": "2 drops",
            "caption": "in whatever you're already drinking"
          }
        },
        {
          "type": "stat",
          "settings": {
            "intro": "Support that lasts",
            "value": "All day",
            "caption": "steady appetite and blood sugar support, morning to night"
          }
        }
      ]
    }
  ]
}
{% endschema %}
