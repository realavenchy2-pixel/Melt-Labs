{%- comment -%}
  Product selector — Apple-style segmented tab switcher. Pick real
  products (or override with custom copy/image); tapping a tab
  crossfades to that product's showcase panel (image, tagline, live
  price, reassurance points, CTA into its page). Fully keyboard
  accessible (ARIA tablist pattern). Works with 2+ products without
  any rebuilding as the lineup grows.
{%- endcomment -%}

<section class="section section--scheme-{{ section.settings.scheme | default: 'white' }} product-selector">
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.subhead != blank -%}
      <div class="section-header section-header--center" data-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{% render 'accent-text', text: section.settings.heading, color: 'blue' %}</h2>
        {%- endif -%}
        {%- if section.settings.subhead != blank -%}
          <p class="lead" style="margin-inline: auto;">{{ section.settings.subhead }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="product-selector__widget" data-product-selector data-reveal>
      <div class="product-selector__tabs" data-selector-tabs role="tablist" aria-label="Choose a product">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          <button
            type="button"
            class="product-selector__tab {% if forloop.first %}is-active{% endif %}"
            data-selector-tab
            role="tab"
            id="selector-tab-{{ section.id }}-{{ forloop.index0 }}"
            aria-controls="selector-panel-{{ section.id }}-{{ forloop.index0 }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          >
            {%- if block.settings.title != blank -%}{{ block.settings.title }}
            {%- elsif product != blank -%}{{ product.title }}
            {%- else -%}Product {{ forloop.index }}{%- endif -%}
          </button>
        {%- endfor -%}
      </div>

      <div class="product-selector__stage" style="--selector-aspect-mobile: {{ section.settings.aspect_mobile }}; --selector-aspect-desktop: {{ section.settings.aspect_desktop }};">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          <div
            class="product-selector__panel"
            data-selector-panel
            id="selector-panel-{{ section.id }}-{{ forloop.index0 }}"
            role="tabpanel"
            aria-labelledby="selector-tab-{{ section.id }}-{{ forloop.index0 }}"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            <div class="product-selector__media">
              {%- if block.settings.image != blank -%}
                <div class="media-slot media-slot--rounded" style="--aspect-mobile: {{ section.settings.aspect_mobile }}; --aspect-desktop: {{ section.settings.aspect_desktop }};">
                  <div class="media-slot__frame"></div>
                  {%- render 'responsive-image', image: block.settings.image, sizes: '(min-width: 900px) 50vw, 100vw' -%}
                </div>
              {%- elsif product != blank and product.featured_image != blank -%}
                <div class="media-slot media-slot--rounded" style="--aspect-mobile: {{ section.settings.aspect_mobile }}; --aspect-desktop: {{ section.settings.aspect_desktop }};">
                  <div class="media-slot__frame"></div>
                  {%- render 'responsive-image', image: product.featured_image, sizes: '(min-width: 900px) 50vw, 100vw' -%}
                </div>
              {%- else -%}
                {%- render 'media-placeholder', label: 'selector_product_photo', aspect_mobile: section.settings.aspect_mobile, aspect_desktop: section.settings.aspect_desktop, class: 'media-slot--rounded' -%}
              {%- endif -%}
            </div>

            <div class="product-selector__body">
              {%- if block.settings.badge != blank -%}
                <span class="eyebrow">{{ block.settings.badge }}</span>
              {%- endif -%}
              <h3 class="product-selector__title">
                {%- if block.settings.title != blank -%}{{ block.settings.title }}
                {%- elsif product != blank -%}{{ product.title }}
                {%- else -%}Product{%- endif -%}
              </h3>
              {%- if block.settings.tagline != blank -%}
                <p class="lead product-selector__tagline">{{ block.settings.tagline }}</p>
              {%- endif -%}
              {%- if product != blank -%}
                <p class="product-selector__price">
                  {{ product.price_min | money }}
                  {%- if product.compare_at_price_max > product.price_min %} <s>{{ product.compare_at_price_max | money }}</s>{% endif -%}
                </p>
              {%- endif -%}
              {%- if block.settings.points != blank -%}
                <ul class="buy-box__reassure">
                  {%- assign items = block.settings.points | newline_to_br | split: '<br />' -%}
                  {%- for item in items -%}
                    {%- assign trimmed = item | strip -%}
                    {%- if trimmed != blank -%}
                      <li>{% render 'icon', name: 'check' %}{{ trimmed }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if product != blank -%}
                <a class="btn btn--gold product-selector__cta" href="{{ product.url }}">
                  {{ block.settings.button_label | default: 'Shop now' }}
                </a>
              {%- elsif block.settings.link != blank -%}
                <a class="btn btn--gold product-selector__cta" href="{{ block.settings.link }}">
                  {{ block.settings.button_label | default: 'Shop now' }}
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product selector",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "tint", "label": "Pale blue" },
        { "value": "ink", "label": "Near-black" }
      ],
      "default": "white"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHOP THE LINEUP" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap a word in *asterisks* to accent it.",
      "default": "Pick your *protocol.*"
    },
    { "type": "textarea", "id": "subhead", "label": "Subhead" },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "aspect_desktop",
      "label": "Desktop image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "select",
      "id": "aspect_mobile",
      "label": "Mobile image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "1 / 1"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides product photo)" },
        { "type": "text", "id": "badge", "label": "Eyebrow / badge", "default": "MELT LABS" },
        { "type": "text", "id": "title", "label": "Title (overrides product title)" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        {
          "type": "textarea",
          "id": "points",
          "label": "Reassurance points (one per line)"
        },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link (used if no product)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Product selector",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "badge": "FOR CRAVINGS + BLOOD SUGAR",
            "tagline": "Two drops in whatever you already drink.",
            "points": "60-day supply\nThird-party tested\nNo stimulants",
            "button_label": "Shop Special Water"
          }
        },
        {
          "type": "product",
          "settings": {
            "badge": "FOR SCALP + HAIR",
            "tagline": "Four drops on the scalp, every night.",
            "points": "Fragrance-free\nThird-party tested\nWorks with color-treated hair",
            "button_label": "Shop KAMI"
          }
        }
      ]
    }
  ]
}
{% endschema %}
