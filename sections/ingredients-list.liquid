{%- comment -%}
  S4 — Ingredients breakdown (reference: PDF p.3, "Take a closer look.").
  Sticky bottle visual beside a plain-language list. Actives and base
  ingredients are separate block types. Terminology rule from the brief:
  always "Cinnamomum cassia", never "cinnamon".
{%- endcomment -%}

<section class="section section--scheme-white">
  <div class="container">
    <div class="section-header" data-reveal>
      <h2 class="h2">{{ section.settings.headline }}</h2>
      {%- if section.settings.subhead != blank -%}
        <p class="lead">{{ section.settings.subhead }}</p>
      {%- endif -%}
    </div>

    <div class="ingredients__layout">
      <div class="ingredients__aside" data-reveal>
        {%- render 'media-placeholder',
          label: 'ingredient_start_frame_bottle',
          aspect_mobile: '4 / 5',
          image: section.settings.image
        -%}
        {%- if section.settings.format_note != blank -%}
          <p class="ingredients__format">{{ section.settings.format_note }}</p>
        {%- endif -%}
      </div>

      <div>
        <ol class="ingredient-list">
          {%- assign i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'active' -%}
              {%- assign i = i | plus: 1 -%}
              <li class="ingredient" data-reveal style="--reveal-i: {{ forloop.index0 | modulo: 4 }};" {{ block.shopify_attributes }}>
                <h3 class="ingredient__name h3">
                  {{ block.settings.name }}
                  {%- if block.settings.source != blank %} <span class="ingredient__source">{{ block.settings.source }}</span>{% endif -%}
                </h3>
                <p class="ingredient__role">{{ block.settings.role }}</p>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>

        {%- assign has_base = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'base' -%}{%- assign has_base = true -%}{%- endif -%}
        {%- endfor -%}

        {%- if has_base -%}
          <h3 class="ingredients__base-title">{{ section.settings.base_title }}</h3>
          <ul class="ingredient-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'base' -%}
                <li class="ingredient ingredient--base" {{ block.shopify_attributes }}>
                  <p class="ingredient__name">{{ block.settings.name }}</p>
                  <p class="ingredient__role">{{ block.settings.role }}</p>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients list",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "What's inside. And what each drop does."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "Six botanicals, each chosen for one job: keeping blood sugar steady and cravings quiet."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bottle image"
    },
    {
      "type": "text",
      "id": "format_note",
      "label": "Format note",
      "default": "2 oz / 60 mL clear glass dropper bottle."
    },
    {
      "type": "text",
      "id": "base_title",
      "label": "Base ingredients title",
      "default": "Base ingredients"
    }
  ],
  "blocks": [
    {
      "type": "active",
      "name": "Active ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Cinnamomum cassia (bark) Extract" },
        { "type": "text", "id": "source", "label": "Latin / source note" },
        {
          "type": "textarea",
          "id": "role",
          "label": "Plain-language mechanism",
          "default": "Supports healthy blood sugar levels and insulin sensitivity."
        }
      ]
    },
    {
      "type": "base",
      "name": "Base ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Water" },
        { "type": "text", "id": "role", "label": "Role", "default": "Base and solvent" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients list",
      "blocks": [
        {
          "type": "active",
          "settings": {
            "name": "Cinnamomum cassia (bark) Extract",
            "role": "The primary active. Supports healthy blood sugar levels and insulin sensitivity, which helps reduce post-meal glucose spikes: the spikes that drive fat storage signaling and cravings."
          }
        },
        {
          "type": "active",
          "settings": {
            "name": "Japanese Knotweed Extract",
            "source": "Polygonum cuspidatum, root",
            "role": "A natural source of trans-resveratrol. The Japanese heritage ingredient and metabolic driver of the formula. Supports metabolic health, antioxidant activity, and healthy inflammatory response."
          }
        },
        {
          "type": "active",
          "settings": {
            "name": "Bitter Melon Extract",
            "source": "Momordica charantia Linn., fruit, 4:1",
            "role": "Traditionally used across Asia for metabolic support. Supports healthy blood sugar metabolism and glucose utilization."
          }
        },
        {
          "type": "active",
          "settings": {
            "name": "Extract of Turmeric Root",
            "source": "Curcuma longa",
            "role": "Antioxidant support and healthy inflammatory response, which plays a role in overall metabolic function."
          }
        },
        {
          "type": "active",
          "settings": {
            "name": "Extract of Licorice Root",
            "role": "Traditionally used to support digestive health and adrenal function; may support healthy cortisol levels and metabolic balance."
          }
        },
        {
          "type": "active",
          "settings": {
            "name": "Matcha",
            "role": "Natural antioxidants (EGCG catechins) that support gentle thermogenesis and a metabolic boost without stimulant jitters."
          }
        },
        { "type": "base", "settings": { "name": "Water", "role": "Base and solvent" } },
        {
          "type": "base",
          "settings": { "name": "Glycerin", "role": "Natural carrier for botanical extracts, adds slight sweetness" }
        },
        {
          "type": "base",
          "settings": { "name": "Potassium Sorbate", "role": "Natural preservative for shelf stability" }
        }
      ]
    }
  ]
}
{% endschema %}
