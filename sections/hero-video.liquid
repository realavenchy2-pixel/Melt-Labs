{%- comment -%}
  S1 — Hero. Autoplay video OR static image, with separate mobile and
  desktop assets, an adjustable overlay, and an adjustable frame shape
  (fill screen, or a fixed 16:9 / 9:16 / 1:1 / 4:5 / 3:4 ratio) so any
  video fits perfectly. Gold CTA anchors to the offer block below. The
  sentinel div lets scroll-fx.js show the product subnav once the hero
  scrolls away.
{%- endcomment -%}

{%- assign hero_mode = section.settings.hero_size | default: 'fill' -%}

<div data-subnav-sentinel></div>

<section
  class="hero hero--{{ hero_mode }}"
  style="--hero-aspect-mobile: {{ section.settings.aspect_mobile }}; --hero-aspect-desktop: {{ section.settings.aspect_desktop }}; --hero-fit: {{ section.settings.media_fit }};"
>
  <div class="hero__media">
    {%- render 'hero-media',
      media_type: section.settings.media_type,
      video_desktop: section.settings.video,
      video_mobile: section.settings.video_mobile,
      image_desktop: section.settings.image,
      image_mobile: section.settings.image_mobile,
      label: 'hero_video_or_image',
      aspect_mobile: '9 / 16',
      aspect_desktop: '16 / 9',
      eager: true
    -%}
    <div class="hero__scrim" aria-hidden="true" style="--scrim-opacity: {{ section.settings.overlay_darkness }};"></div>
  </div>

  <div class="container hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h1 class="hero__headline">{% render 'accent-text', text: section.settings.headline, color: 'gold' %}</h1>

    {%- if section.settings.subhead != blank -%}
      <p class="hero__subhead">{{ section.settings.subhead }}</p>
    {%- endif -%}

    <a class="btn btn--gold" href="#offer">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Hero video",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Hero media",
      "info": "Switch between the autoplay video and a static image. Both assets can stay uploaded while you decide.",
      "options": [
        { "value": "video", "label": "Autoplay video" },
        { "value": "image", "label": "Image" }
      ],
      "default": "video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Desktop video (muted loop)"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video (muted loop)",
      "info": "Optional. Falls back to the desktop video if empty."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Falls back to the desktop image if empty."
    },
    {
      "type": "range",
      "id": "overlay_darkness",
      "label": "Overlay darkness",
      "info": "Darkens the video/image so the headline pops. Raise it for bright footage.",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Frame shape"
    },
    {
      "type": "select",
      "id": "hero_size",
      "label": "Hero height",
      "info": "Fill screen crops to a full-height banner. Fixed ratio sizes the frame to match your video so it fits with no awkward crop.",
      "options": [
        { "value": "fill", "label": "Fill screen" },
        { "value": "sized", "label": "Fixed ratio" }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "aspect_desktop",
      "label": "Desktop ratio",
      "info": "Used when Hero height is Fixed ratio.",
      "options": [
        { "value": "16 / 9", "label": "16:9 (wide)" },
        { "value": "1 / 1", "label": "1:1 (square)" },
        { "value": "4 / 5", "label": "4:5 (portrait)" },
        { "value": "9 / 16", "label": "9:16 (tall)" },
        { "value": "3 / 4", "label": "3:4 (portrait)" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "select",
      "id": "aspect_mobile",
      "label": "Mobile ratio",
      "info": "Used when Hero height is Fixed ratio.",
      "options": [
        { "value": "9 / 16", "label": "9:16 (tall)" },
        { "value": "1 / 1", "label": "1:1 (square)" },
        { "value": "4 / 5", "label": "4:5 (portrait)" },
        { "value": "3 / 4", "label": "3:4 (portrait)" },
        { "value": "16 / 9", "label": "16:9 (wide)" }
      ],
      "default": "9 / 16"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "info": "Cover fills the frame (may crop edges). Contain shows the whole video (adds bars).",
      "options": [
        { "value": "cover", "label": "Cover (fill)" },
        { "value": "contain", "label": "Contain (show all)" }
      ],
      "default": "cover"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MELT LABS"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "info": "Wrap a word in *asterisks* to accent it.",
      "default": "Two drops. *Quiet* the cravings. Steady your sugar."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "A Japanese botanical serum designed to work with your body, not against your routine."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "See the protocol"
    }
  ],
  "presets": [{ "name": "Hero video" }]
}
{% endschema %}
