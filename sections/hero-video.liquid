{%- comment -%}
  S1 — Product hero.

  This renders the homepage hero's markup, class for class. It used to
  carry its own .hero__* system, which meant every spacing or type
  decision had to be re-made here and the two heroes drifted apart with
  each round of tuning. Emitting .home-hero__* instead means there is
  nothing left to keep in sync: the product hero picks up whatever the
  homepage hero is doing, from the same rules, automatically.

  It keeps the three things the homepage hero has no use for - an
  eyebrow, a reassurance line under the button, and the sentinel that
  reveals the sticky Buy subnav once the hero scrolls away. Every hook
  scroll-fx.js uses is a data attribute (data-hero, data-autoplay-video,
  data-video-toggle, data-subnav-sentinel), so none of that depends on
  the class names.
{%- endcomment -%}

{%- liquid
  assign hero_mode = section.settings.hero_size | default: 'fill'
  assign content_position = section.settings.content_position | default: 'bottom'
  assign content_align = section.settings.content_align | default: 'center'

  # The toggle only makes sense over a video that is actually playing.
  assign show_toggle = false
  if section.settings.media_type == 'video' and section.settings.show_video_toggle
    if section.settings.video != blank or section.settings.video_mobile != blank
      assign show_toggle = true
    endif
  endif

  # CTA target: explicit link wins, else a picked product's page, else the
  # on-page #offer anchor. Lets the marketing lander send the button to
  # the separate offer/product page.
  assign hero_cta = '#offer'
  if section.settings.cta_link != blank
    assign hero_cta = section.settings.cta_link
  elsif section.settings.product != blank
    assign hero_cta = section.settings.product.url
  endif

  # Space above the button. Left empty at the default so the homepage
  # hero's own rule is what applies - matching it by inheriting it rather
  # than by restating a number that could drift again. Only a deliberate
  # move off the default writes an inline override, and because that is
  # emitted with the markup it survives a stale cached stylesheet.
  assign actions_style = ''
  assign gap_vh = section.settings.actions_gap
  if gap_vh != blank and gap_vh != 4.5
    assign gap_min = gap_vh | times: 389 | divided_by: 1000.0
    assign gap_max = gap_vh | times: 611 | divided_by: 1000.0
    assign actions_style = 'margin-top: clamp(' | append: gap_min | append: 'rem, ' | append: gap_vh | append: 'vh, ' | append: gap_max | append: 'rem);'
  endif
-%}

<section
  {%- comment -%}
    --tint is the scheme the homepage hero runs, and it has to match:
    .home-hero--ink re-colours the subhead to 0.78 alpha at the same
    specificity as the over-media rule but later in the file, so an ink
    hero would quietly set a dimmer subhead than the homepage. The
    scheme only paints behind the media anyway.
  {%- endcomment -%}
  class="home-hero home-hero--tint home-hero--{{ hero_mode }} home-hero--pos-{{ content_position }} home-hero--align-{{ content_align }} home-hero--has-media"
  style="--hero-aspect-mobile: {{ section.settings.aspect_mobile }}; --hero-aspect-desktop: {{ section.settings.aspect_desktop }}; --hero-fit: {{ section.settings.media_fit }};"
  data-hero
>
  <div class="home-hero__media">
    {%- render 'hero-media',
      media_type: section.settings.media_type,
      video_desktop: section.settings.video,
      video_mobile: section.settings.video_mobile,
      image_desktop: section.settings.image,
      image_mobile: section.settings.image_mobile,
      label: 'hero_video_or_image',
      aspect_mobile: '9 / 16',
      aspect_desktop: '16 / 9',
      eager: true
    -%}
    <div class="home-hero__scrim" aria-hidden="true" style="--scrim-opacity: {{ section.settings.overlay_darkness }};"></div>
  </div>

  <div class="container home-hero__content home-hero__content--over-media">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h1 class="home-hero__headline">{% render 'accent-text', text: section.settings.headline, color: 'gold' %}</h1>

    {%- if section.settings.subhead != blank -%}
      <p class="home-hero__subhead">{{ section.settings.subhead }}</p>
    {%- endif -%}

    <div class="home-hero__actions"{% if actions_style != blank %} style="{{ actions_style }}"{% endif %}>
      <a class="btn btn--gold" href="{{ hero_cta }}">{{ section.settings.cta_label }}</a>

      {%- comment -%}
        Apple's second action is a plain chevron link, never a second
        button - one primary action stays unmistakably primary.
      {%- endcomment -%}
      {%- if section.settings.cta2_label != blank -%}
        <a class="hero__link" href="{{ section.settings.cta2_link | default: '#' }}">
          {{ section.settings.cta2_label }}
          <span class="hero__link-chevron" aria-hidden="true">{% render 'icon', name: 'chevron-right' %}</span>
        </a>
      {%- endif -%}

      {%- if section.settings.microcopy != blank -%}
        <p class="hero__microcopy">{{ section.settings.microcopy }}</p>
      {%- endif -%}
    </div>

    {%- comment -%}
      Sentinel sits right after the hero's own CTA. scroll-fx.js reveals
      the sticky Buy subnav only once this marker scrolls above the top
      of the viewport - i.e. once the hero button is no longer visible.
    {%- endcomment -%}
    <div data-subnav-sentinel aria-hidden="true"></div>
  </div>

  {%- comment -%}
    Play/pause. Ships labelled "Pause" because the video autoplays;
    scroll-fx.js relabels it, and flips it to paused up front when the
    visitor asks for reduced motion. Hidden from no-JS visitors, where
    it would be a button that does nothing.
  {%- endcomment -%}
  {%- if show_toggle -%}
    <button
      class="hero__video-toggle"
      type="button"
      data-video-toggle
      aria-pressed="false"
      aria-label="Pause background video"
    >
      <span class="hero__video-toggle-icon" data-video-toggle-icon="pause">{% render 'icon', name: 'pause' %}</span>
      <span class="hero__video-toggle-icon" data-video-toggle-icon="play" hidden>{% render 'icon', name: 'play' %}</span>
    </button>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero video",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Hero media",
      "info": "Switch between the autoplay video and a static image. Both assets can stay uploaded while you decide.",
      "options": [
        { "value": "video", "label": "Autoplay video" },
        { "value": "image", "label": "Image" }
      ],
      "default": "video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Desktop video (muted loop)"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video (muted loop)",
      "info": "Optional. Falls back to the desktop video if empty."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Falls back to the desktop image if empty."
    },
    {
      "type": "range",
      "id": "overlay_darkness",
      "label": "Overlay darkness",
      "info": "Darkens the video/image so the headline pops. Raise it for bright footage; 100 makes the bottom of the frame fully solid.",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "show_video_toggle",
      "label": "Show a play/pause button on the video",
      "info": "Sits in the bottom corner of the frame. Recommended: autoplay a visitor cannot stop is a control they do not have.",
      "default": true
    },
    {
      "type": "header",
      "content": "Copy placement"
    },
    {
      "type": "range",
      "id": "actions_gap",
      "label": "Space above the button",
      "info": "Separates the copy from the button so it reads as the thing to press, not the last line of the sentence. Measured against screen height, so it holds its proportion on every phone.",
      "min": 0,
      "max": 20,
      "step": 0.5,
      "unit": "vh",
      "default": 4.5
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Where the copy sits",
      "info": "Bottom keeps the top of the video clear, so the footage is the subject and the button closes the frame.",
      "options": [
        { "value": "bottom", "label": "Bottom of the frame" },
        { "value": "center", "label": "Centered" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Text alignment",
      "options": [
        { "value": "center", "label": "Centered" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Frame shape"
    },
    {
      "type": "select",
      "id": "hero_size",
      "label": "Hero height",
      "info": "Fill screen crops to a full-height banner. Fixed ratio sizes the frame to match your video so it fits with no awkward crop.",
      "options": [
        { "value": "fill", "label": "Fill screen" },
        { "value": "sized", "label": "Fixed ratio" }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "aspect_desktop",
      "label": "Desktop ratio",
      "info": "Used when Hero height is Fixed ratio.",
      "options": [
        { "value": "16 / 9", "label": "16:9 (wide)" },
        { "value": "1 / 1", "label": "1:1 (square)" },
        { "value": "4 / 5", "label": "4:5 (portrait)" },
        { "value": "9 / 16", "label": "9:16 (tall)" },
        { "value": "3 / 4", "label": "3:4 (portrait)" }
      ],
      "default": "16 / 9"
    },
    {
      "type": "select",
      "id": "aspect_mobile",
      "label": "Mobile ratio",
      "info": "Used when Hero height is Fixed ratio.",
      "options": [
        { "value": "9 / 16", "label": "9:16 (tall)" },
        { "value": "1 / 1", "label": "1:1 (square)" },
        { "value": "4 / 5", "label": "4:5 (portrait)" },
        { "value": "3 / 4", "label": "3:4 (portrait)" },
        { "value": "16 / 9", "label": "16:9 (wide)" }
      ],
      "default": "9 / 16"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "info": "Cover fills the frame (may crop edges). Contain shows the whole video (adds bars).",
      "options": [
        { "value": "cover", "label": "Cover (fill)" },
        { "value": "contain", "label": "Contain (show all)" }
      ],
      "default": "cover"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MELT LABS"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "info": "Wrap a word in *asterisks* to accent it.",
      "default": "Two drops. *Quiet* the cravings. Steady your sugar."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "A Japanese botanical serum designed to work with your body, not against your routine."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "See the protocol"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary link label",
      "info": "Optional. Renders as a plain chevron link beside the button, not a second button, e.g. \"Learn more\".",
      "default": ""
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary link URL"
    },
    {
      "type": "text",
      "id": "microcopy",
      "label": "Reassurance line under the button",
      "info": "Small supporting line, e.g. shipping and guarantee terms."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Link button to product",
      "info": "The button will link to this product's page. Overridden by an explicit Button link below."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link (override)",
      "info": "Leave blank to use the product page above, or the on-page #offer anchor if no product is set."
    }
  ],
  "presets": [{ "name": "Hero video" }]
}
{% endschema %}
