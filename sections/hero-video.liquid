{%- comment -%}
  S1 — Hero. Full-bleed autoplay video OR static image, with separate
  mobile and desktop assets and an adjustable overlay so headline copy
  stays legible over any footage. Gold CTA anchors to the offer block
  below. The sentinel div lets scroll-fx.js show the product subnav once
  the hero scrolls away.
{%- endcomment -%}

<div data-subnav-sentinel></div>

<section class="hero">
  <div class="hero__media">
    {%- render 'hero-media',
      media_type: section.settings.media_type,
      video_desktop: section.settings.video,
      video_mobile: section.settings.video_mobile,
      image_desktop: section.settings.image,
      image_mobile: section.settings.image_mobile,
      label: 'hero_video_or_image',
      aspect_mobile: '9 / 16',
      aspect_desktop: '16 / 9',
      eager: true
    -%}
    <div class="hero__scrim" aria-hidden="true" style="--scrim-opacity: {{ section.settings.overlay_darkness }};"></div>
  </div>

  <div class="container hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h1 class="hero__headline">{% render 'accent-text', text: section.settings.headline, color: 'gold' %}</h1>

    {%- if section.settings.subhead != blank -%}
      <p class="hero__subhead">{{ section.settings.subhead }}</p>
    {%- endif -%}

    <a class="btn btn--gold" href="#offer">{{ section.settings.cta_label }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Hero video",
  "settings": [
    {
      "type": "select",
      "id": "media_type",
      "label": "Hero media",
      "info": "Switch between the autoplay video and a static image. Both assets can stay uploaded while you decide.",
      "options": [
        { "value": "video", "label": "Autoplay video" },
        { "value": "image", "label": "Image" }
      ],
      "default": "video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Desktop video (muted loop)"
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Mobile video (muted loop)",
      "info": "Optional. Falls back to the desktop video if empty."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Falls back to the desktop image if empty."
    },
    {
      "type": "range",
      "id": "overlay_darkness",
      "label": "Overlay darkness",
      "info": "Darkens the video/image so the headline pops. Raise it for bright footage.",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "MELT LABS"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "info": "Wrap a word in *asterisks* to accent it.",
      "default": "Two drops. *Quiet* the cravings. Steady your sugar."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "A Japanese botanical serum designed to work with your body, not against your routine."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "See the protocol"
    }
  ],
  "presets": [{ "name": "Hero video" }]
}
{% endschema %}
