{%- comment -%}
  S6 — "The Science" storyboard. Headline + intro, then a fully
  customizable visual storyboard: add as many "Chapter" blocks as you
  like, each an image beside a paragraph. Optional in-house study stats
  (with count-up) close it out.

  Two layouts, set per section:
    stacked  — chapters run down the page, alternating image side, like a
               scrollytelling sequence.
    carousel — chapters become swipeable cards on the shared carousel
               component, image above copy. Better when the chapters are
               parallel views of one idea rather than a sequence, and it
               keeps a long storyboard from turning the page into a
               scroll marathon on a phone.
{%- endcomment -%}

{%- comment -%}
  Falls back to carousel, matching the schema default: the theme editor
  writes templates back without keys it does not yet know about, which
  already silently reverted one lander to the stacked layout. Defaulting
  the other way means a dropped key is a no-op instead of a regression.
{%- endcomment -%}
{%- assign layout = section.settings.layout | default: 'carousel' -%}

<section class="section section--scheme-{{ section.settings.scheme | default: 'ink' }}">
  <div class="container container--narrow science__intro" data-reveal>
    <h2 class="h2">{% render 'accent-text', text: section.settings.headline, color: 'gold' %}</h2>
    {%- if section.settings.body != blank -%}
      <p class="lead" style="margin-inline: auto; margin-top: 1rem;">{{ section.settings.body }}</p>
    {%- endif -%}
  </div>

  {%- assign chapter_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'chapter' -%}
      {%- assign chapter_count = chapter_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if chapter_count > 0 -%}
    {%- if layout == 'carousel' -%}
      {%- comment -%}
        Card layout: image on top, copy beneath, so the chapter still reads
        as one unit at a slide's width. The media keeps the same ratio
        control as the stacked layout, and a chapter with no copy at all
        (the common case on the landers, where the image carries it)
        renders as a clean image card with no empty caption box.
      {%- endcomment -%}
      {%- capture slides -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'chapter' -%}
            <div class="carousel__slide" {{ block.shopify_attributes }}>
              <figure class="science-slide">
                {%- render 'media-placeholder',
                  label: 'science_story_image',
                  aspect_mobile: '4 / 5',
                  aspect_desktop: section.settings.chapter_aspect,
                  image: block.settings.image,
                  sizes: '(min-width: 768px) 640px, 100vw',
                  class: 'media-slot--rounded science__media'
                -%}
                {%- if block.settings.eyebrow != blank or block.settings.heading != blank or block.settings.text != blank -%}
                  <figcaption class="science-slide__body">
                    {%- if block.settings.eyebrow != blank -%}
                      <span class="eyebrow">{{ block.settings.eyebrow }}</span>
                    {%- endif -%}
                    {%- if block.settings.heading != blank -%}
                      <h3 class="science-chapter__title">{{ block.settings.heading }}</h3>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <p class="science-chapter__text">{{ block.settings.text }}</p>
                    {%- endif -%}
                  </figcaption>
                {%- endif -%}
              </figure>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      <div class="science__carousel" data-reveal>
        {%-
          render 'carousel',
          slides: slides,
          id: section.id,
          label: section.settings.headline,
          autoplay: section.settings.autoplay,
          interval: section.settings.autoplay_interval,
          pill: true
        -%}
      </div>
    {%- else -%}
      <div class="container science__story">
        {%- assign chapter_i = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'chapter' -%}
          {%- assign rem = chapter_i | modulo: 2 -%}
          <div class="science-chapter{% if rem == 1 %} science-chapter--flip{% endif %}" data-reveal {{ block.shopify_attributes }}>
            <div class="science-chapter__media">
              {%- render 'media-placeholder',
                label: 'science_story_image',
                aspect_mobile: '4 / 5',
                aspect_desktop: section.settings.chapter_aspect,
                image: block.settings.image,
                sizes: '(min-width: 800px) 560px, 100vw',
                class: 'media-slot--rounded science__media'
              -%}
            </div>
            <div class="science-chapter__body">
              {%- if block.settings.eyebrow != blank -%}
                <span class="eyebrow">{{ block.settings.eyebrow }}</span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="science-chapter__title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="science-chapter__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>
          {%- assign chapter_i = chapter_i | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.stat_1_value != blank or section.settings.stat_2_value != blank or section.settings.stat_3_value != blank -%}
    <div class="container container--narrow science__stats">
      <div class="stat-row">
        {%- assign stats = 'stat_1_value,stat_1_caption|stat_2_value,stat_2_caption|stat_3_value,stat_3_caption' | split: '|' -%}
        {%- for pair in stats -%}
          {%- assign keys = pair | split: ',' -%}
          {%- assign value = section.settings[keys[0]] -%}
          {%- assign caption = section.settings[keys[1]] -%}
          {%- if value != blank -%}
            <div class="stat" data-reveal style="--reveal-i: {{ forloop.index0 }};">
              <p class="stat__intro">{{ section.settings.stat_intro }}</p>
              {%- comment -%}
                The real value ships in the markup. scroll-fx.js zeroes it
                only once it knows it can animate, so a visitor without JS
                reads the true statistic instead of "0%".
              {%- endcomment -%}
              <p class="stat__value" data-count-up="{{ value }}">{{ value }}</p>
              <p class="stat__caption">{{ caption }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.attribution != blank -%}
        <p class="stat__note">{{ section.settings.attribution }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Science",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Color scheme",
      "options": [
        { "value": "ink", "label": "Near-black" },
        { "value": "white", "label": "White" },
        { "value": "tint", "label": "Pale blue" }
      ],
      "default": "ink"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "info": "Wrap a word in *asterisks* to accent it, e.g. *Science*.",
      "default": "The *Science* Behind Special Water"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Intro",
      "default": "Special Water was built around one mechanism: stabilizing blood sugar to shut off the cravings that sabotage weight loss."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Storyboard layout",
      "info": "Stacked runs the chapters down the page, alternating sides. Carousel turns them into swipeable cards.",
      "options": [
        { "value": "carousel", "label": "Swipeable carousel" },
        { "value": "stacked", "label": "Stacked down the page" }
      ],
      "default": "carousel"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay the carousel",
      "info": "Carousel layout only. Advances on its own while in view; shoppers can pause with the play/pause button. Never runs if the visitor has reduced motion turned on.",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay speed",
      "min": 3000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "default": 5000
    },
    {
      "type": "select",
      "id": "chapter_aspect",
      "label": "Storyboard image ratio (desktop)",
      "options": [
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "1 / 1", "label": "Square (1:1)" },
        { "value": "3 / 4", "label": "Portrait (3:4)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "4 / 5"
    },
    { "type": "header", "content": "In-house study stats (optional)" },
    { "type": "text", "id": "stat_intro", "label": "Stat lead-in", "default": "In an in-house study" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "93%" },
    { "type": "text", "id": "stat_1_caption", "label": "Stat 1 caption", "default": "reported fewer cravings" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "90%" },
    { "type": "text", "id": "stat_2_caption", "label": "Stat 2 caption", "default": "lost 10+ lbs" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value", "default": "90%" },
    { "type": "text", "id": "stat_3_caption", "label": "Stat 3 caption", "default": "saw blood sugar stabilize" },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution line",
      "default": "Based on our in-house study. Individual results may vary."
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Storyboard chapter",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Paragraph" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Science",
      "blocks": [
        { "type": "chapter", "settings": { "eyebrow": "THE MECHANISM", "heading": "It starts with blood sugar.", "text": "Every craving spike traces back to an unstable glucose curve. Flatten the curve and the cravings quiet down on their own." } },
        { "type": "chapter", "settings": { "eyebrow": "THE BOTANICALS", "heading": "Japanese actives, measured doses.", "text": "Cinnamon bark, knotweed, and matcha are dosed for the pathways that matter, then third-party tested before a bottle is filled." } },
        { "type": "chapter", "settings": { "eyebrow": "THE RESULT", "heading": "A routine you don't have to think about.", "text": "Two drops in whatever you already drink. The work happens quietly, in the background, all day." } }
      ]
    }
  ]
}
{% endschema %}
