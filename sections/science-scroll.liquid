{%- comment -%}
  S6 — "The Science Behind Special Water" (reference: PDF p.7-10,
  Apple's scroll-scrubbed exploded view).

  Scroll-only playback: the video never autoplays. Its currentTime is
  driven purely by scroll position through the sticky stage (scroll down
  = forward, up = rewind), with eased seeking in scroll-fx.js so it
  feels smooth. A poster frame paints instantly and the media backdrop
  is ink, so it never flashes light blue while buffering. Under reduced
  motion / no-JS it holds on the poster/first frame.
{%- endcomment -%}

<section class="section section--scheme-ink">
  <div class="container container--narrow science__intro" data-reveal>
    <h2 class="h2">{% render 'accent-text', text: section.settings.headline, color: 'gold' %}</h2>
    <p class="lead" style="margin-inline: auto; margin-top: 1rem;">{{ section.settings.body }}</p>
  </div>

  <div
    class="science__scroller is-static"
    data-scrub
    data-scrub-vh="{{ section.settings.scrub_length }}"
  >
    <div class="science__stage">
      <div class="science__frame">
        {%- if section.settings.video -%}
          <div class="media-slot media-slot--rounded science__media" style="--aspect-mobile: 4 / 5; --aspect-desktop: 1 / 1;">
            <div class="media-slot__frame"></div>
            <video
              class="science__video"
              data-scrub-video
              muted
              playsinline
              webkit-playsinline
              disablepictureinpicture
              preload="auto"
              {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1200 }}"{% endif %}
              aria-hidden="true"
              tabindex="-1"
            >
              {%- for source in section.settings.video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          </div>
        {%- else -%}
          <!-- SWAP: science_scrollable_scrub_video, 4:5 mobile / 1:1 desktop.
               Scroll-scrubbed (moves only as the page scrolls, never
               autoplays). For smooth seeking in both directions, export
               frame-seekable / keyframe-dense (short GOP). -->
          <div class="media-slot media-slot--rounded science__media" style="--aspect-mobile: 4 / 5; --aspect-desktop: 1 / 1;">
            <div class="media-slot__frame"></div>
            <div class="media-slot__label" aria-hidden="true">
              <strong>science_scrollable_scrub_video</strong>
              <span>4 / 5 mobile &middot; 1 / 1 desktop</span>
              <span>Moves on scroll only. Export keyframe-dense (short GOP) for smoothest scrubbing.</span>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
    <div class="science__spacer" aria-hidden="true"></div>
  </div>

  <div class="container container--narrow science__stats">
    <div class="stat-row">
      {%- assign stats = 'stat_1_value,stat_1_caption|stat_2_value,stat_2_caption|stat_3_value,stat_3_caption' | split: '|' -%}
      {%- for pair in stats -%}
        {%- assign keys = pair | split: ',' -%}
        {%- assign value = section.settings[keys[0]] -%}
        {%- assign caption = section.settings[keys[1]] -%}
        {%- if value != blank -%}
          <div class="stat" data-reveal style="--reveal-i: {{ forloop.index0 }};">
            <p class="stat__intro">{{ section.settings.stat_intro }}</p>
            <p class="stat__value" data-count-up="{{ value }}">0%</p>
            <p class="stat__caption">{{ caption }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.attribution != blank -%}
      <p class="stat__note">{{ section.settings.attribution }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Science scroll",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "info": "Wrap a word in *asterisks* to accent it, e.g. *Science*.",
      "default": "The *Science* Behind Special Water"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Special Water was built around one mechanism: stabilizing blood sugar to shut off the cravings that sabotage weight loss."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Scroll-scrubbed video",
      "info": "Export frame-seekable / keyframe-dense so scrubbing looks smooth in both directions."
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster frame (shown before video loads)"
    },
    {
      "type": "range",
      "id": "scrub_length",
      "label": "Scroll sensitivity",
      "info": "How much scroll distance covers the full video. Lower = faster scrub, higher = slower and more gradual.",
      "min": 150,
      "max": 600,
      "step": 25,
      "unit": "vh",
      "default": 350
    },
    { "type": "text", "id": "stat_intro", "label": "Stat lead-in", "default": "In an in-house study" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "93%" },
    {
      "type": "text",
      "id": "stat_1_caption",
      "label": "Stat 1 caption",
      "default": "reported fewer cravings"
    },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "90%" },
    { "type": "text", "id": "stat_2_caption", "label": "Stat 2 caption", "default": "lost 10+ lbs" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value", "default": "90%" },
    {
      "type": "text",
      "id": "stat_3_caption",
      "label": "Stat 3 caption",
      "default": "saw blood sugar stabilize"
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution line",
      "default": "Based on our in-house study. Individual results may vary."
    }
  ],
  "presets": [{ "name": "Science scroll" }]
}
{% endschema %}
