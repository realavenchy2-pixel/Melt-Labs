{%- comment -%}
  Apple-style scroll-aware local nav: hidden over the hero, slides in
  once the hero scrolls away (scroll-fx.js watches the hero sentinel).
  Gold button anchors back to the native buy box.
{%- endcomment -%}

{%- liquid
  if section.settings.product != blank
    assign product = section.settings.product
  endif
  # Prefer an explicit link; else the product's page; else the #offer anchor.
  assign buy_href = '#offer'
  if section.settings.cta_link != blank
    assign buy_href = section.settings.cta_link
  elsif product != blank
    assign buy_href = product.url
  endif
  # Logo: section-level upload wins, else the theme's global logo
  # (Theme settings → Logo), else fall back to the product/shop name.
  assign subnav_logo = section.settings.logo
  if subnav_logo == blank
    assign subnav_logo = settings.logo
  endif
  assign logo_style = 'height: ' | append: section.settings.logo_height | append: 'px'
-%}

<nav class="product-subnav" data-subnav aria-label="Product">
  <div class="container product-subnav__inner">
    {%- if subnav_logo != blank -%}
      <a class="product-subnav__logo" href="{{ routes.root_url }}">
        {{ subnav_logo | image_url: width: 300 | image_tag: widths: '80, 150, 300', alt: shop.name, style: logo_style, loading: 'eager', decoding: 'async' }}
      </a>
    {%- else -%}
      <span class="product-subnav__title">
        {%- if product != blank -%}{{ product.title }}{%- else -%}{{ shop.name }}{%- endif -%}
      </span>
    {%- endif -%}
    <span class="product-subnav__meta">
      {%- if product != blank -%}
        <span class="product-subnav__price">{{ product.selected_or_first_available_variant.price | money }}</span>
      {%- endif -%}
      <a class="btn btn--gold" href="{{ buy_href }}">{{ section.settings.cta_label }}</a>
    </span>
  </div>
</nav>

{% schema %}
{
  "name": "Product subnav",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "On product pages this defaults to the current product."
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Replaces the product name with your logo. Leave blank to use the theme's logo (Theme settings → Logo) if one is set there, or the product name as plain text otherwise."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Buy"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Leave blank to use the product's page (or the #offer anchor). Set it to send the Buy button to a specific offer page."
    }
  ],
  "presets": [{ "name": "Product subnav" }]
}
{% endschema %}
