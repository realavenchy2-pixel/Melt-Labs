<header class="site-header">
  <div class="container site-header__inner">
    {%- if section.settings.menu != blank -%}
      <button
        class="site-header__burger"
        type="button"
        data-menu-toggle
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="site-header__burger-lines" aria-hidden="true"></span>
      </button>
    {%- endif -%}

    <a class="site-header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo -%}
        {{
          settings.logo
          | image_url: width: 480
          | image_tag: width: settings.logo_width, widths: '120, 240, 480', alt: shop.name, loading: 'eager', decoding: 'async'
        }}
      {%- else -%}
        <span class="site-header__wordmark">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- if section.settings.menu != blank -%}
      <nav class="site-header__nav" aria-label="Main">
        <ul class="site-header__nav-list">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a
                href="{{ link.url }}"
                {% if link.active %}aria-current="page"{% endif %}
              >
                {{ link.title }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <a class="site-header__cart" href="{{ routes.cart_url }}" aria-label="Cart ({{ cart.item_count }} items)">
      {%- render 'icon', name: 'cart' -%}
    </a>
  </div>

  {%- if section.settings.menu != blank -%}
    <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
      <nav aria-label="Mobile">
        <ul class="mobile-menu__list">
          {%- for link in section.settings.menu.links -%}
            <li>
              <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>
  {%- endif -%}
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "info": "Edit items in Navigation settings, or leave empty to hide the nav.",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
