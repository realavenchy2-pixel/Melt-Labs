{%- comment -%}
  S3 — Transformation carousel. Square before/after photo per slide with
  a short quote overlaid (reference: PDF p.2, "Get the highlights.").
  Blocks are duplicable for as many transformations as exist; images
  ship as labeled placeholders until real UGC lands.
{%- endcomment -%}

{%- comment -%}
  Renders nothing at all when there are no slides. Verified testimonials
  are the only thing that belongs here: with the blocks removed the whole
  section - heading included - disappears rather than leaving an empty
  carousel shell on the page. Add slides back and it returns.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="section section--flush section--scheme-white" style="padding-block: var(--section-pad);">
  <div class="container section-header" data-reveal>
    <h2 class="h2">{{ section.settings.headline }}</h2>
    {%- if section.settings.subhead != blank -%}
      <p class="lead">{{ section.settings.subhead }}</p>
    {%- endif -%}
  </div>

  {%- capture slides -%}
    {%- for block in section.blocks -%}
      <div class="carousel__slide" {{ block.shopify_attributes }}>
        <figure class="testimonial-card">
          {%- render 'media-placeholder',
            label: 'transformation_photo_before_after',
            aspect_mobile: '1 / 1',
            image: block.settings.image
          -%}
          <figcaption class="testimonial-card__overlay">
            <blockquote class="testimonial-card__quote">&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
            <p class="testimonial-card__author">{{ block.settings.author }}</p>
          </figcaption>
        </figure>
      </div>
    {%- endfor -%}
  {%- endcapture -%}

  {%-
    render 'carousel',
    slides: slides,
    id: section.id,
    label: section.settings.headline,
    autoplay: section.settings.autoplay,
    interval: section.settings.autoplay_interval,
    pill: true
  -%}
</section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonial carousel",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Real routines. Real results."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Intro",
      "info": "Optional line under the heading."
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "info": "Advances on its own while in view; shoppers can pause with the play/pause button. Never runs if the visitor has reduced motion turned on.",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay speed",
      "min": 3000,
      "max": 8000,
      "step": 500,
      "unit": "ms",
      "default": 4500
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Before/after photo (square)"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "Quote",
          "default": "I stopped snacking without even trying."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Attribution",
          "default": "Placeholder, 34"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonial carousel",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "quote": "I stopped snacking without even trying.",
            "author": "Placeholder, 34"
          }
        },
        {
          "type": "slide",
          "settings": {
            "quote": "Two drops in my coffee and the cravings just... quiet down.",
            "author": "Placeholder, 41"
          }
        },
        {
          "type": "slide",
          "settings": {
            "quote": "Didn't change anything else. Just added this.",
            "author": "Placeholder, 29"
          }
        }
      ]
    }
  ]
}
{% endschema %}
